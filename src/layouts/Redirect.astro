---
import '../styles/global.css';
const { target, title, description = '', canonical, cta = 'Continue' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
</head>
<body>
  <main class="redirect-wrap">
    <div class="redirect-card">
      <img src="/assets/images/logo-aas.webp" alt="Advanced Action Sports" width="110" height="110" />
      <h1>{title}</h1>
      {description && <p>{description}</p>}
      <a class="btn btn-primary" href={target}>{cta}</a>
    </div>
  </main>
  <script define:vars={{ target }}>window.location.replace(target);</script>
</body>
</html>
