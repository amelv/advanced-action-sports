---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 | Advanced Action Sports"
  description="That page isn't here."
  robots="noindex"
>
  <section class="page-content not-found" style="min-height: 60vh; display: grid; place-items: center; text-align: center;">
    <div class="container">
      <h2>404</h2>
      <p>That page isn't here. It may have moved, or the link may be out of date.</p>
      <div class="btn-wrapper">
        <a class="btn btn-primary" href="/">Back to Home</a>
        <a class="btn btn-secondary" href="/tickets/">Tickets</a>
      </div>
    </div>
  </section>
</BaseLayout>
