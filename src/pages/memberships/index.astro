---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.jsx';
---
<BaseLayout
  title="MEMBERSHIPS | Advanced Action Sports"
  description="Join the Fight Club at Advanced Action Sports in Webster and Granville, Massachusetts. $1 first month, unlimited open play, exclusive discounts, and more."
  canonical="https://www.advancedactionsports.com/memberships/"
  ogTitle="MEMBERSHIPS | Advanced Action Sports"
  ogDescription="Join the Fight Club at Advanced Action Sports in Webster and Granville, Massachusetts. $1 first month, unlimited open play, exclusive discounts, and more."
>
<PageHero title="MEMBERSHIPS" btnUrl="https://waivermaster.com/sign.html?q=DPJVWWZHYXY5V" btnText="Join Now" bgImg="airsoft-outdoor-advancing.avif" bgAlt="Airsoft players slowly advancing together outdoors in a gritty tactical formation" />

  <section class="page-actions">
    <div class="container">
      <a href="https://advancedactionsports.square.site/s/appointments" class="btn btn-secondary"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>Book Now</a>
    </div>
  </section>

  <section class="page-content">
    <div class="container">
      <h2>Unleash Your Inner Warrior: Join the Advanced Action Sports Fight Club!</h2>
      <p>Are you ready to take your airsoft game to the next level?</p>
      <img src="/assets/images/airsoft-player-celebrating.avif" alt="Airsoft player raising gun and fist in the air celebrating a win" class="content-float-right" loading="lazy">
      <p>Join our Fight Club Membership program, where adrenaline meets camaraderie! With unparalleled benefits and an electrifying atmosphere, this is more than just a membership—it's your ticket to an action-packed lifestyle!</p>

      <div class="content-image">
        <img src="/assets/images/players-gearing-up.avif" alt="Airsoft and paintball players preparing for a match, gearing up and socializing" loading="lazy">
      </div>

      <div class="membership-pricing">
        <div class="pricing-item">
          <div class="pricing-item-name">First Month</div>
          <div class="pricing-item-price price-amber">$1</div>
          <div class="pricing-item-desc">Try the club with a full month of unlimited open play</div>
        </div>
        <div class="pricing-item">
          <div class="pricing-item-name">After That</div>
          <div class="pricing-item-price price-amber">$49.99<span class="price-unit">/mo</span></div>
          <div class="pricing-item-desc">Unlimited open play at both locations, month to month after your year agreement</div>
        </div>
      </div>

      <h2>Why Choose Our Fight Club Membership?</h2>

      <ol class="benefit-list">
        <li>
          <h3>Unlimited Open Play</h3>
          <p>Play either location, any open play session — indoor and outdoor — year-round.</p>
        </li>
        <li>
          <h3>Epic Open Play Schedule</h3>
          <p>Extended play days: Wednesday 4–9 PM, Saturday and Sunday 11 AM–4 PM at Webster (April 1 through the Wednesday before Thanksgiving).</p>
        </li>
        <li>
          <h3>Amazing 1st Month Value</h3>
          <p>Dive into the action for just $1 your first month.</p>
        </li>
        <li>
          <h3>Affordable Adventure</h3>
          <p>Continue after your first month for only $49.99 a month.</p>
        </li>
        <li>
          <h3>Commitment Has Its Perks</h3>
          <p>Lock in a full year agreement for guaranteed access to all our airsoft events.</p>
        </li>
        <li>
          <h3>Flexibility When You Need It</h3>
          <p>After your year agreement, switch to a flexible month-to-month plan.</p>
        </li>
        <li>
          <h3>Exclusive Discounts</h3>
          <p>Members get special discounts on tournaments and exclusive events.</p>
        </li>
        <li>
          <h3>Join the Community</h3>
          <p>Become part of a passionate airsoft family — new friends, friendly competition, and shared games.</p>
        </li>
        <li>
          <h3>Sharpen Your Skills</h3>
          <p>Regular play builds tactics and technique, whether you're new or a seasoned pro.</p>
        </li>
        <li>
          <h3>Hassle-Free Payments</h3>
          <p>Dues are billed directly to your credit card, so you can focus on playing.</p>
        </li>
      </ol>

      <h2>Ready to Join the Fight?</h2>
      <p>Don't miss out on the ultimate airsoft experience. Become a member of the Advanced Action Sports Fight Club today and transform your weekends into epic battles.</p>

      <div class="btn-wrapper">
        <a href="https://waivermaster.com/sign.html?q=DPJVWWZHYXY5V" class="btn btn-primary">Join Now</a>
      </div>
    </div>
  </section>
</BaseLayout>
