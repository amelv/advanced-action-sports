---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.jsx';
---
<BaseLayout
  title="Partners & Supporters | Advanced Action Sports"
  description="The businesses and teams that support Advanced Action Sports in Webster and Granville, Massachusetts."
  canonical="https://www.advancedactionsports.com/partners/"
  ogTitle="Partners & Supporters | Advanced Action Sports"
  ogDescription="The businesses and teams that support Advanced Action Sports."
>
<PageHero
  title="PARTNERS & SUPPORTERS"
  btnUrl="mailto:contact@advancedactionsports.com?subject=Partnership%20Inquiry"
  btnText="Contact Us"
  bgImg="airsoft-team-barricade-advance.avif"
  bgAlt="Airsoft players advancing together behind a field barricade"
/>

<section class="page-content">
  <div class="container">
    <h2>Partners &amp; Supporters</h2>
    <p>These are the businesses and teams that support Advanced Action Sports.</p>
    <div class="partner-grid">
      <a class="partner-card" href="https://ampedairsoft.com/" target="_blank" rel="noreferrer noopener">
        <span class="partner-logo"><img src="/assets/images/partners/amped-airsoft.webp" alt="Amped Airsoft" /></span>
        <span class="partner-name">Amped Airsoft</span>
        <span class="partner-link-label">Visit website</span>
      </a>

      <a class="partner-card" href="https://www.msato.org/" target="_blank" rel="noreferrer noopener">
        <span class="partner-logo"><img src="/assets/images/partners/msato-milsim.webp" alt="MSATO Milsim" /></span>
        <span class="partner-name">MSATO Milsim</span>
        <span class="partner-link-label">Visit website</span>
      </a>

      <a class="partner-card partner-card--wordmark" href="https://www.stagops.com/" target="_blank" rel="noreferrer noopener">
        <span class="partner-wordmark">STAGOPS</span>
        <span class="partner-link-label">Visit website</span>
      </a>

      <a class="partner-card" href="https://ubgllc.com/" target="_blank" rel="noreferrer noopener">
        <span class="partner-logo"><img src="/assets/images/partners/ubg.webp" alt="UBG Airsoft" /></span>
        <span class="partner-name">UBG</span>
        <span class="partner-link-label">Visit website</span>
      </a>

      <div class="partner-card">
        <span class="partner-logo partner-logo--dark"><img src="/assets/images/partners/brothers-of-chaos.webp" alt="Brothers of Chaos" /></span>
        <span class="partner-name">Brothers of Chaos</span>
      </div>

      <div class="partner-card partner-card--wordmark partner-card--pending">
        <span class="partner-wordmark">Daggers / ATS</span>
      </div>

      <a class="partner-card" href="https://xtremepbma.com/" target="_blank" rel="noreferrer noopener">
        <span class="partner-logo"><img src="/assets/images/partners/xtreme-paintball.webp" alt="Xtreme Paintball &amp; Airsoft" /></span>
        <span class="partner-name">Xtreme Paintball &amp; Airsoft</span>
        <span class="partner-location">Agawam, MA</span>
        <span class="partner-link-label">Visit website</span>
      </a>

      <div class="partner-card partner-card--wordmark partner-card--pending">
        <span class="partner-wordmark">RPS</span>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
