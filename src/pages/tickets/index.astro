---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.jsx';
---
<BaseLayout
  title="Tickets | Advanced Action Sports"
  description="Buy admission tickets for Advanced Action Sports in Webster and Granville, Massachusetts."
  canonical="https://www.advancedactionsports.com/tickets/"
  ogTitle="Tickets | Advanced Action Sports"
  ogDescription="Choose Webster or Granville and buy admission tickets for Advanced Action Sports."
>
<PageHero title="TICKETS" btnUrl="#choose" btnText="Choose a Location" bgImg="airsoft-team-barricade-advance.avif" bgAlt="Airsoft players advancing together behind a field barricade" />

<section class="page-content" id="choose">
  <div class="container">
    <h2>Choose Your Field</h2>
    <p>Admission is sold through our Square store. Pick the location you're playing at.</p>

    <div class="ticket-grid">
      <article class="ticket-card">
        <img class="ticket-img" src="/assets/images/airsoft-arena-drone-overview.avif" alt="Aerial view of the Advanced Action Sports field in Webster, MA" loading="lazy">
        <span class="ticket-badge">Walk-in play</span>
        <h2>Webster, MA</h2>
        <p>Regular airsoft and paintball play at our Webster field.</p>
        <a href="https://advancedactionsports.square.site/shop/admission-for-webster-ma/9" class="btn">Buy Webster Tickets</a>
      </article>

      <article class="ticket-card">
        <img class="ticket-img" src="/assets/images/airsoft-outdoor-advancing.avif" alt="Players advancing across the outdoor field at Advanced Action Sports Granville, MA" loading="lazy">
        <span class="ticket-badge ticket-badge--event">Special events</span>
        <h2>Granville, MA</h2>
        <p>Milsim and special events at New England's biggest field. Tickets appear when an event is on sale.</p>
        <a href="https://advancedactionsports.square.site/shop/admissions-for-granville-ma/23" class="btn">Buy Granville Tickets</a>
      </article>
    </div>

    <div class="ticket-note">
      <p>Planning a private party or group outing? <a href="https://advancedactionsports.square.site/s/appointments"><strong>Book an appointment through Square.</strong></a></p>
    </div>
  </div>
</section>
</BaseLayout>
